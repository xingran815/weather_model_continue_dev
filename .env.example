# Copy this file to .env and set your values. Do not commit .env.

# MySQL (app connection and container init)
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=weather_sql_container
MYSQL_PORT=3306
MYSQL_DB=weather_db
MYSQL_DATABASE=weather_db

# MLflow
MLFLOW_TRACKING_URI=http://weather_mlflow_container:8080

# Model API (used by Streamlit and Airflow)
MODEL_API_URI=http://weather_model_container:8000

# DVC/Dagshub authentication
DAGSHUB_KEY=your_dagshub_key
