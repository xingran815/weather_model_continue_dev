FROM mysql:8.0

# MySQL config (MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, etc.) is provided via
# docker-compose env_file: .env at runtime.

WORKDIR /mysql
COPY .dvc ./.dvc
COPY .git ./.git
COPY data/raw/weatherAUS.csv.dvc ./data/raw/weatherAUS.csv.dvc
RUN microdnf install -y python3 python3-pip git \
    && microdnf clean all \
    && pip install dvc dvc-s3 \
    && dvc pull -r origin data/raw/weatherAUS.csv

# Copy the CSV data and SQL scripts into the container
COPY mysql/create_table.sql /docker-entrypoint-initdb.d/1_create_table.sql
COPY mysql/import_data.sql /docker-entrypoint-initdb.d/2_import_data.sql

# Starting MySQL server with specific options
CMD ["mysqld", "--secure-file-priv=/mysql/data", "--local-infile=1"]

EXPOSE 3306